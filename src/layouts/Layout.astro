---
const { title = 'Renewal Party' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="An Astro + TinaCMS powered event site with Cloudflare R2 media support." />
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        line-height: 1.5;
        font-weight: 400;
        color: #0f172a;
        background: #f8fafc;
      }
      body {
        margin: 0;
        background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
      }
      main {
        max-width: 860px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      .card {
        border-radius: 1.25rem;
        background: #fff;
        padding: 1.5rem;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.08);
        margin-bottom: 1.25rem;
      }
      img {
        width: 100%;
        border-radius: 1rem;
        display: block;
        object-fit: cover;
      }
      a {
        color: #2563eb;
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
